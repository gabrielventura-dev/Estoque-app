<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Categorias</h2>
    <a href="/categorias/nova" class="btn btn-success">Nova categoria</a>
</div>

{{!-- Cada categoria vira um card; "categorias" vem de routes/categorias.js --}}
{{#each categorias}}
    <div class="card mb-2">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">{{nome}}</h5>
                <small class="text-muted">Slug: {{slug}}</small>
            </div>
            <div>
                <a href="/categorias/editar/{{_id}}" class="btn btn-primary btn-sm">Editar</a>
                {{!-- Deletar é um POST com o id escondido; a classe form-deletar ativa o confirm() do script.js --}}
                <form action="/categorias/deletar" method="POST" class="d-inline form-deletar">
                    <input type="hidden" name="id" value="{{_id}}">
                    <button type="submit" class="btn btn-danger btn-sm">Deletar</button>
                </form>
            </div>
        </div>
    </div>
{{else}}
    <p class="text-muted">Nenhuma categoria cadastrada.</p>
{{/each}}
