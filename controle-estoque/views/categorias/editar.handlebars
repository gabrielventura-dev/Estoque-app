{{!-- Erros de validação enviados pela rota (array "erros" com objetos { texto }) --}}
{{#each erros}}
    <div class="alert alert-danger">{{texto}}</div>
{{/each}}

<h2>Editar categoria</h2>
<div class="card">
    <div class="card-body">
        {{!-- method POST: os campos chegam na rota em req.body (body-parser) --}}
        <form action="/categorias/editar" method="POST">
            {{!-- Campo escondido com o _id: a rota usa req.body.id para saber quem editar --}}
            <input type="hidden" name="id" value="{{categoria._id}}">
            <label for="nome">Nome:</label>
            <input type="text" id="nome" name="nome" class="form-control" value="{{categoria.nome}}">
            <label for="slug" class="mt-2">Slug:</label>
            <input type="text" id="slug" name="slug" class="form-control" value="{{categoria.slug}}">
            <button type="submit" class="btn btn-success mt-3">Salvar alterações</button>
            <a href="/categorias" class="btn btn-secondary mt-3">Cancelar</a>
        </form>
    </div>
</div>
