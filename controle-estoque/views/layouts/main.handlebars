<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Controle de Estoque</title>
    <!-- Bootstrap 5 via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <!-- CSS próprio (pasta public) -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    {{!-- Barra de navegação do Bootstrap (navbar). Em telas pequenas vira o botão "hambúrguer" --}}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Controle de Estoque</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Início</a></li>
                    <li class="nav-item"><a class="nav-link" href="/produtos">Produtos</a></li>
                    <li class="nav-item"><a class="nav-link" href="/categorias">Categorias</a></li>
                    <li class="nav-item"><a class="nav-link" href="/fornecedores">Fornecedores</a></li>
                    <li class="nav-item"><a class="nav-link" href="/movimentacoes">Movimentações</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        {{!-- {{>_msg}} inclui a parcial views/partials/_msg.handlebars (mensagens flash) --}}
        {{>_msg}}
        {{!-- {{{body}}} é onde entra o conteúdo de cada view (3 chaves = HTML sem escapar) --}}
        {{{body}}}
    </div>

    <!-- JavaScript do Bootstrap (necessário para o menu abrir no celular) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- JavaScript próprio do front-end -->
    <script src="/js/script.js"></script>
</body>
</html>
