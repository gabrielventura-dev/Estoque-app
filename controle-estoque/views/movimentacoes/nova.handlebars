{{!-- Erros de validação e de regra de negócio (ex.: estoque insuficiente) --}}
{{#each erros}}
    <div class="alert alert-danger">{{texto}}</div>
{{/each}}

<h2>Nova movimentação</h2>
<div class="card">
    <div class="card-body">
        <form action="/movimentacoes/nova" method="POST">
            <label for="produto">Produto:</label>
            {{!-- Mostra o estoque atual de cada produto para ajudar na saída --}}
            <select id="produto" name="produto" class="form-select">
                <option value="0">Selecione...</option>
                {{#each produtos}}
                    <option value="{{_id}}" {{#if (igual _id ../movimentacao.produto)}}selected{{/if}}>{{nome}} ({{codigo}}) - estoque: {{quantidade}}</option>
                {{/each}}
            </select>

            {{!-- Radio buttons: só um tipo pode ser escolhido; o valor chega em req.body.tipo --}}
            <label class="mt-2 d-block">Tipo:</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="tipo" id="entrada" value="entrada" {{#if (igual movimentacao.tipo "entrada")}}checked{{/if}}>
                <label class="form-check-label" for="entrada">Entrada (soma ao estoque)</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="tipo" id="saida" value="saida" {{#if (igual movimentacao.tipo "saida")}}checked{{/if}}>
                <label class="form-check-label" for="saida">Saída (subtrai do estoque)</label>
            </div>

            <label for="quantidade" class="mt-2 d-block">Quantidade:</label>
            <input type="number" id="quantidade" name="quantidade" min="1" class="form-control" value="{{movimentacao.quantidade}}">

            <label for="observacao" class="mt-2">Observação:</label>
            <input type="text" id="observacao" name="observacao" placeholder="Ex.: venda balcão, compra NF 123" class="form-control" value="{{movimentacao.observacao}}">

            <button type="submit" class="btn btn-success mt-3">Registrar</button>
            <a href="/movimentacoes" class="btn btn-secondary mt-3">Cancelar</a>
        </form>
    </div>
</div>
