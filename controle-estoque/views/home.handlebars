{{!-- Dashboard: os dados vêm de routes/principal.js --}}
<h2 class="mb-4">Dashboard</h2>

{{!-- Cards com os totais (grid do Bootstrap: 2 por linha no celular, 4 no computador) --}}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center card-total">
            <div class="card-body">
                <h6 class="text-muted">Produtos</h6>
                <h3>{{totalProdutos}}</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center card-total">
            <div class="card-body">
                <h6 class="text-muted">Categorias</h6>
                <h3>{{totalCategorias}}</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center card-total">
            <div class="card-body">
                <h6 class="text-muted">Fornecedores</h6>
                <h3>{{totalFornecedores}}</h3>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center card-total">
            <div class="card-body">
                <h6 class="text-muted">Valor em estoque</h6>
                {{!-- "dinheiro" é um helper definido no app.js --}}
                <h3>{{dinheiro valorTotal}}</h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-danger text-white">Estoque baixo</div>
            <div class="card-body">
                {{!-- #each percorre a lista; o bloco {{else}} aparece quando ela está vazia --}}
                {{#each estoqueBaixo}}
                    <div class="d-flex justify-content-between border-bottom py-2">
                        <a href="/produtos/{{_id}}">{{nome}} ({{codigo}})</a>
                        <span class="badge bg-danger">{{quantidade}} / mín. {{estoqueMinimo}}</span>
                    </div>
                {{else}}
                    <p class="text-muted mb-0">Nenhum produto com estoque baixo.</p>
                {{/each}}
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Últimas movimentações</div>
            <div class="card-body">
                {{!-- produto.nome existe por causa do populate("produto") na rota --}}
                {{#each ultimasMovimentacoes}}
                    <div class="d-flex justify-content-between border-bottom py-2">
                        <span>
                            {{#if (igual tipo "entrada")}}<span class="badge bg-success">Entrada</span>{{else}}<span class="badge bg-warning text-dark">Saída</span>{{/if}}
                            {{#if produto}}{{produto.nome}}{{else}}(produto removido){{/if}}
                        </span>
                        <span>{{quantidade}} un. <small class="text-muted">{{data date}}</small></span>
                    </div>
                {{else}}
                    <p class="text-muted mb-0">Nenhuma movimentação registrada.</p>
                {{/each}}
                <a href="/movimentacoes/nova" class="btn btn-success mt-3">Nova movimentação</a>
            </div>
        </div>
    </div>
</div>
