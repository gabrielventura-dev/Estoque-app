{{!-- Erros de validação enviados pela rota --}}
{{#each erros}}
    <div class="alert alert-danger">{{texto}}</div>
{{/each}}

<h2>Novo produto</h2>
<div class="card">
    <div class="card-body">
        <form action="/produtos/novo" method="POST" class="row g-2">
            <div class="col-md-8">
                <label for="nome">Nome:</label>
                <input type="text" id="nome" name="nome" class="form-control" value="{{produto.nome}}">
            </div>
            <div class="col-md-4">
                <label for="codigo">Código (SKU):</label>
                <input type="text" id="codigo" name="codigo" placeholder="Ex.: BEB-001" class="form-control" value="{{produto.codigo}}">
            </div>
            <div class="col-12">
                <label for="descricao">Descrição:</label>
                <textarea id="descricao" name="descricao" class="form-control">{{produto.descricao}}</textarea>
            </div>
            <div class="col-md-4">
                <label for="preco">Preço (R$):</label>
                {{!-- classe "preco": o script.js formata o valor ao sair do campo --}}
                <input type="text" id="preco" name="preco" placeholder="0.00" class="form-control preco" value="{{produto.preco}}">
            </div>
            <div class="col-md-4">
                <label for="quantidade">Quantidade inicial:</label>
                <input type="number" id="quantidade" name="quantidade" min="0" class="form-control" value="{{produto.quantidade}}">
            </div>
            <div class="col-md-4">
                <label for="estoqueMinimo">Estoque mínimo:</label>
                <input type="number" id="estoqueMinimo" name="estoqueMinimo" min="0" class="form-control" value="{{produto.estoqueMinimo}}">
            </div>
            <div class="col-md-6">
                <label for="categoria">Categoria:</label>
                <select id="categoria" name="categoria" class="form-select">
                    <option value="0">Selecione...</option>
                    {{!-- ../produto acessa o objeto "produto" de fora do #each; o helper "igual" marca a opção já escolhida --}}
                    {{#each categorias}}
                        <option value="{{_id}}" {{#if (igual _id ../produto.categoria)}}selected{{/if}}>{{nome}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="col-md-6">
                <label for="fornecedor">Fornecedor:</label>
                <select id="fornecedor" name="fornecedor" class="form-select">
                    <option value="0">Selecione...</option>
                    {{#each fornecedores}}
                        <option value="{{_id}}" {{#if (igual _id ../produto.fornecedor)}}selected{{/if}}>{{nome}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-success mt-2">Cadastrar produto</button>
                <a href="/produtos" class="btn btn-secondary mt-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>
