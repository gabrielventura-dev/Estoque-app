<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Produtos</h2>
    <a href="/produtos/novo" class="btn btn-success">Novo produto</a>
</div>

{{!-- Busca: method GET coloca o campo na URL (/produtos?busca=...), lido na rota com req.query.busca --}}
<form action="/produtos" method="GET" class="d-flex mb-3">
    <input type="text" name="busca" class="form-control me-2" placeholder="Buscar por nome ou código" value="{{busca}}">
    <button type="submit" class="btn btn-primary">Buscar</button>
    {{#if busca}}<a href="/produtos" class="btn btn-secondary ms-2">Limpar</a>{{/if}}
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Código</th><th>Nome</th><th>Categoria</th><th>Fornecedor</th><th>Preço</th><th>Qtd.</th><th>Situação</th><th></th></tr>
        </thead>
        <tbody>
            {{#each produtos}}
                {{!-- data-quantidade e data-minimo são lidos pelo script.js para destacar estoque baixo --}}
                <tr data-quantidade="{{quantidade}}" data-minimo="{{estoqueMinimo}}">
                    <td>{{codigo}}</td>
                    <td><a href="/produtos/{{_id}}">{{nome}}</a></td>
                    {{!-- categoria.nome e fornecedor.nome existem graças ao populate() --}}
                    <td>{{categoria.nome}}</td>
                    <td>{{fornecedor.nome}}</td>
                    <td>{{dinheiro preco}}</td>
                    <td>{{quantidade}}</td>
                    {{!-- Preenchido pelo script.js com o selo "OK" ou "Estoque baixo" --}}
                    <td class="situacao"></td>
                    <td class="text-end text-nowrap">
                        <a href="/produtos/editar/{{_id}}" class="btn btn-primary btn-sm">Editar</a>
                        <form action="/produtos/deletar" method="POST" class="d-inline form-deletar">
                            <input type="hidden" name="id" value="{{_id}}">
                            <button type="submit" class="btn btn-danger btn-sm">Deletar</button>
                        </form>
                    </td>
                </tr>
            {{else}}
                <tr><td colspan="8" class="text-muted">Nenhum produto encontrado.</td></tr>
            {{/each}}
        </tbody>
    </table>
</div>
