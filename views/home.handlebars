{{!-- Dashboard: os dados vêm de routes/principal.js --}}
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
    <p class="text-sm text-gray-500">Resumo geral do estoque e alertas de reposição.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/movimentacoes/nova" class="inline-flex items-center gap-1.5 bg-white border border-gray-300 text-gray-700 px-3.5 py-2 rounded-lg hover:bg-gray-50 transition text-sm font-medium">Nova movimentação</a>
    <a href="/produtos/novo" class="inline-flex items-center gap-1.5 bg-indigo-700 text-white px-4 py-2 rounded-lg hover:bg-indigo-800 transition text-sm font-medium">+ Novo produto</a>
  </div>
</div>

{{!-- Cards com os totais (grid: 2 por linha no celular, 4 no computador) --}}
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
    <h2 class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-1">Produtos</h2>
    <p class="text-2xl font-bold text-gray-900 tabular-nums">{{totalProdutos}}</p>
  </div>
  <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
    <h2 class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-1">Categorias</h2>
    <p class="text-2xl font-bold text-gray-900 tabular-nums">{{totalCategorias}}</p>
  </div>
  <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
    <h2 class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-1">Fornecedores</h2>
    <p class="text-2xl font-bold text-gray-900 tabular-nums">{{totalFornecedores}}</p>
  </div>
  <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
    <h2 class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-1">Valor em estoque</h2>
    {{!-- "dinheiro" é um helper definido no app.js --}}
    <p class="text-2xl font-bold text-gray-900 tabular-nums">{{dinheiro valorTotal}}</p>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between gap-2">
      <h2 class="font-semibold text-red-700">Estoque baixo</h2>
      <a href="/produtos" class="text-sm text-indigo-700 hover:underline font-medium">Ver produtos</a>
    </div>
    <ul class="divide-y divide-gray-100 text-sm" role="list">
      {{!-- #each percorre a lista; o bloco {{else}} aparece quando ela está vazia --}}
      {{#each estoqueBaixo}}
        <li class="flex items-center justify-between gap-3 px-5 py-3">
          <a href="/produtos/{{_id}}" class="font-medium text-gray-900 hover:text-indigo-700">{{nome}} <span class="text-gray-500 font-normal">({{codigo}})</span></a>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800 tabular-nums whitespace-nowrap">{{quantidade}} / mín. {{estoqueMinimo}}</span>
        </li>
      {{else}}
        <li class="px-5 py-10 text-center text-gray-500">Nenhum produto com estoque baixo. Tudo em dia!</li>
      {{/each}}
    </ul>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between gap-2">
      <h2 class="font-semibold text-gray-900">Últimas movimentações</h2>
      <a href="/movimentacoes" class="text-sm text-indigo-700 hover:underline font-medium">Ver histórico</a>
    </div>
    <ul class="divide-y divide-gray-100 text-sm" role="list">
      {{!-- produto.nome existe por causa do populate("produto") na rota --}}
      {{#each ultimasMovimentacoes}}
        <li class="flex items-center justify-between gap-3 px-5 py-3">
          <span class="flex items-center gap-2">
            {{#if (igual tipo "entrada")}}
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">Entrada</span>
            {{else}}
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">Saída</span>
            {{/if}}
            <span class="font-medium text-gray-900">{{#if produto}}{{produto.nome}}{{else}}(produto removido){{/if}}</span>
          </span>
          <span class="text-right tabular-nums">{{quantidade}} un. <small class="block text-xs text-gray-500">{{data date}}</small></span>
        </li>
      {{else}}
        <li class="px-5 py-10 text-center text-gray-500">Nenhuma movimentação registrada.</li>
      {{/each}}
    </ul>
  </div>
</div>
