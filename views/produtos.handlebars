<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Produtos</h1>
    <p class="text-sm text-gray-500">Gerencie o catálogo de produtos do estoque.</p>
  </div>
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
    <div class="relative w-full sm:w-64">
      <label for="busca-produtos" class="sr-only">Buscar produtos</label>
      <input type="search" id="busca-produtos" placeholder="Buscar por nome ou categoria…" class="w-full border border-gray-300 rounded-lg pl-9 pr-3 py-2 text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute left-3 top-2.5 text-gray-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
    </div>
    <a href="/produtos/cadastrar" class="inline-flex items-center justify-center bg-indigo-700 text-white px-4 py-2 rounded-lg hover:bg-indigo-800 transition text-sm font-medium whitespace-nowrap">+ Novo Produto</a>
  </div>
</div>

<p id="busca-status" class="sr-only" aria-live="polite"></p>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Nome</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Categoria</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Preço</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Qtd.</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Mínimo</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600 text-right">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#if produtos.length}}
          {{#each produtos}}
          <tr class="border-b last:border-b-0" data-produto-row>
            <td class="px-5 py-3 font-medium text-gray-900">{{nome}}</td>
            <td class="px-5 py-3">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">{{categoria.nome}}</span>
            </td>
            <td class="px-5 py-3 tabular-nums text-gray-700">R$ {{toFixed preco 2}}</td>
            <td class="px-5 py-3 tabular-nums">
              <span class="inline-flex items-center gap-1.5 {{#if (gt quantidade estoqueMinimo)}}text-green-700 font-medium{{else}}text-red-700 font-semibold{{/if}}">
                {{quantidade}}
                {{#unless (gt quantidade estoqueMinimo)}}
                  <span class="px-1.5 py-0.5 rounded text-[11px] bg-red-100 text-red-800 font-semibold">Baixo</span>
                {{/unless}}
              </span>
            </td>
            <td class="px-5 py-3 text-gray-500 tabular-nums">{{estoqueMinimo}}</td>
            <td class="px-5 py-3 text-right">
              <form method="POST" action="/produtos/{{id}}/excluir" class="inline" onsubmit="return confirm('Excluir o produto \"{{nome}}\"?')">
                <button type="submit" class="text-red-600 hover:text-red-800 font-medium text-sm hover:underline">Excluir</button>
              </form>
            </td>
          </tr>
          {{/each}}
          <tr id="sem-resultados-busca" class="hidden">
            <td class="px-5 py-10 text-center text-gray-500" colspan="6">Nenhum produto encontrado para essa busca.</td>
          </tr>
        {{else}}
          <tr>
            <td class="px-5 py-10 text-center text-gray-500" colspan="6">Nenhum produto cadastrado. Clique em "+ Novo Produto" para começar.</td>
          </tr>
        {{/if}}
      </tbody>
    </table>
  </div>
</div>

<script>
  // Filtro rápido da tabela conforme o usuário digita na busca
  (function () {
    const input = document.getElementById('busca-produtos');
    const emptyRow = document.getElementById('sem-resultados-busca');
    const status = document.getElementById('busca-status');
    const rows = Array.from(document.querySelectorAll('tbody tr[data-produto-row]'));
    if (!input || !rows.length) return;

    input.addEventListener('input', function (e) {
      const termo = e.target.value.trim().toLowerCase();
      let visiveis = 0;

      rows.forEach(function (row) {
        const texto = row.textContent.toLowerCase();
        const match = texto.includes(termo);
        row.style.display = match ? '' : 'none';
        if (match) visiveis += 1;
      });

      if (emptyRow) {
        emptyRow.classList.toggle('hidden', visiveis > 0);
      }
      if (status) {
        status.textContent = visiveis + ' produto(s) encontrado(s).';
      }
    });
  })();
</script>
