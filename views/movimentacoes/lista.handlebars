<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Histórico de movimentações</h1>
    <p class="text-sm text-gray-500">Entradas e saídas registradas no estoque.</p>
  </div>
  <a href="/movimentacoes/nova" class="inline-flex items-center justify-center self-start sm:self-auto bg-indigo-700 text-white px-4 py-2 rounded-lg hover:bg-indigo-800 transition text-sm font-medium whitespace-nowrap">+ Nova movimentação</a>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Data</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Produto</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Tipo</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Qtd.</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Observação</th>
        </tr>
      </thead>
      <tbody>
        {{!-- Mais recentes primeiro (sort na rota). produto.nome vem do populate --}}
        {{#each movimentacoes}}
          <tr class="border-b last:border-b-0">
            <td class="px-5 py-3 text-gray-500 tabular-nums whitespace-nowrap">{{data date}}</td>
            <td class="px-5 py-3 font-medium text-gray-900">{{#if produto}}<a href="/produtos/{{produto._id}}" class="hover:text-indigo-700 hover:underline">{{produto.nome}}</a>{{else}}<span class="text-gray-500">(produto removido)</span>{{/if}}</td>
            {{!-- Selo verde para entrada e azul para saída --}}
            <td class="px-5 py-3">
              {{#if (igual tipo "entrada")}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">Entrada</span>
              {{else}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">Saída</span>
              {{/if}}
            </td>
            <td class="px-5 py-3 font-semibold tabular-nums {{#if (igual tipo "entrada")}}text-green-700{{else}}text-blue-700{{/if}}">{{#if (igual tipo "entrada")}}+{{else}}-{{/if}}{{quantidade}}</td>
            <td class="px-5 py-3 text-gray-700">{{observacao}}</td>
          </tr>
        {{else}}
          <tr><td colspan="5" class="px-5 py-10 text-center text-gray-500">Nenhuma movimentação registrada.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
