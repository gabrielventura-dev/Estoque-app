{{!-- Parcial de mensagens: success_msg e error_msg vêm do middleware em app.js (res.locals) --}}
{{#if success_msg}}
  <div class="mb-6 px-4 py-3.5 rounded-xl border bg-emerald-50 border-emerald-200 text-emerald-800 text-sm font-medium shadow-sm" role="alert">{{success_msg}}</div>
{{/if}}
{{#if error_msg}}
  <div class="mb-6 px-4 py-3.5 rounded-xl border bg-red-50 border-red-200 text-red-800 text-sm font-medium shadow-sm" role="alert">{{error_msg}}</div>
{{/if}}
