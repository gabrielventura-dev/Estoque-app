<div class="max-w-2xl mx-auto">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Categorias</h1>
      <p class="text-sm text-gray-500">Organize seus produtos por categoria.</p>
    </div>
    <span class="inline-flex items-center self-start sm:self-auto px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 tabular-nums">
      {{categorias.length}} cadastrada(s)
    </span>
  </div>

  <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
    <!-- Formulário para adicionar nova categoria -->
    <form method="POST" action="/categorias/cadastrar" class="flex flex-col sm:flex-row gap-2 mb-6">
      <div class="flex-1">
        <label for="nome-categoria" class="sr-only">Nome da categoria</label>
        <input id="nome-categoria" type="text" name="nome" placeholder="Nome da nova categoria (ex: Bebidas)" class="w-full border border-gray-300 rounded-lg px-3.5 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none" required>
      </div>
      <button type="submit" class="bg-indigo-700 text-white px-4 py-2 rounded-lg hover:bg-indigo-800 transition text-sm font-medium whitespace-nowrap">+ Adicionar</button>
    </form>

    {{#if categorias.length}}
      <ul class="divide-y divide-gray-100 border border-gray-100 rounded-lg overflow-hidden" role="list">
        {{#each categorias}}
        <li class="flex items-center gap-3 px-4 py-3 bg-white hover:bg-gray-50 transition text-sm font-medium text-gray-800">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
          <span>{{nome}}</span>
        </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="text-sm text-gray-500 text-center py-6">Nenhuma categoria cadastrada. Adicione a primeira acima.</p>
    {{/if}}
  </div>
</div>
