{{!-- Detalhe do produto: dados com populate + histórico de movimentações deste produto --}}
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">{{produto.nome}}</h1>
    <p class="text-sm text-gray-500">Código: {{produto.codigo}}</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/produtos/editar/{{produto._id}}" class="inline-flex items-center gap-1.5 bg-white border border-gray-300 text-gray-700 px-3.5 py-2 rounded-lg hover:bg-gray-50 transition text-sm font-medium">Editar</a>
    {{!-- Passa o id na URL para o formulário já vir com este produto selecionado --}}
    <a href="/movimentacoes/nova?produto={{produto._id}}" class="inline-flex items-center gap-1.5 bg-indigo-700 text-white px-4 py-2 rounded-lg hover:bg-indigo-800 transition text-sm font-medium">Registrar movimentação</a>
  </div>
</div>

<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 mb-6">
  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm">
    <div class="sm:col-span-2">
      <dt class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-1">Descrição</dt>
      <dd class="text-gray-900">{{produto.descricao}}</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-1">Categoria</dt>
      <dd class="text-gray-900">{{produto.categoria.nome}}</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-1">Fornecedor</dt>
      <dd class="text-gray-900">{{produto.fornecedor.nome}}</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-1">Preço</dt>
      <dd class="text-gray-900 tabular-nums">{{dinheiro produto.preco}}</dd>
    </div>
    {{!-- data-* lidos pelo script.js para mostrar o selo de estoque baixo --}}
    <div data-quantidade="{{produto.quantidade}}" data-minimo="{{produto.estoqueMinimo}}">
      <dt class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-1">Estoque</dt>
      <dd class="text-gray-900 tabular-nums flex items-center gap-2">
        {{produto.quantidade}} <span class="text-gray-500">(mínimo: {{produto.estoqueMinimo}})</span>
        <span class="situacao"></span>
      </dd>
    </div>
  </dl>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
  <div class="px-5 py-4 border-b border-gray-200">
    <h2 class="font-semibold text-gray-900">Histórico de movimentações</h2>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Data</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Tipo</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Qtd.</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Observação</th>
        </tr>
      </thead>
      <tbody>
        {{#each movimentacoes}}
          <tr class="border-b last:border-b-0">
            <td class="px-5 py-3 text-gray-500 tabular-nums whitespace-nowrap">{{data date}}</td>
            <td class="px-5 py-3">
              {{#if (igual tipo "entrada")}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">Entrada</span>
              {{else}}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">Saída</span>
              {{/if}}
            </td>
            <td class="px-5 py-3 font-semibold tabular-nums {{#if (igual tipo "entrada")}}text-green-700{{else}}text-blue-700{{/if}}">{{#if (igual tipo "entrada")}}+{{else}}-{{/if}}{{quantidade}}</td>
            <td class="px-5 py-3 text-gray-700">{{observacao}}</td>
          </tr>
        {{else}}
          <tr><td colspan="4" class="px-5 py-10 text-center text-gray-500">Nenhuma movimentação para este produto.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<a href="/produtos" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition text-sm font-medium">Voltar</a>
