<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Produtos</h1>
    <p class="text-sm text-gray-500">Gerencie o catálogo de produtos do estoque.</p>
  </div>
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
    {{!-- Busca: method GET coloca o campo na URL (/produtos?busca=...), lido na rota com req.query.busca --}}
    <form action="/produtos" method="GET" class="flex gap-2">
      <div class="relative w-full sm:w-64">
        <label for="busca" class="sr-only">Buscar produtos</label>
        <input type="search" id="busca" name="busca" placeholder="Buscar por nome ou código" value="{{busca}}" class="w-full border border-gray-300 rounded-lg pl-9 pr-3 py-2 text-sm bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute left-3 top-2.5 text-gray-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      </div>
      <button type="submit" class="bg-white border border-gray-300 text-gray-700 px-3.5 py-2 rounded-lg hover:bg-gray-50 transition text-sm font-medium">Buscar</button>
      {{#if busca}}<a href="/produtos" class="inline-flex items-center px-3.5 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100 transition">Limpar</a>{{/if}}
    </form>
    <a href="/produtos/novo" class="inline-flex items-center justify-center bg-indigo-700 text-white px-4 py-2 rounded-lg hover:bg-indigo-800 transition text-sm font-medium whitespace-nowrap">+ Novo produto</a>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Código</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Nome</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Categoria</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Fornecedor</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Preço</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Qtd.</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Situação</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600 text-right">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each produtos}}
          {{!-- data-quantidade e data-minimo são lidos pelo script.js para destacar estoque baixo --}}
          <tr class="border-b last:border-b-0" data-quantidade="{{quantidade}}" data-minimo="{{estoqueMinimo}}">
            <td class="px-5 py-3 text-gray-500 tabular-nums">{{codigo}}</td>
            <td class="px-5 py-3 font-medium text-gray-900"><a href="/produtos/{{_id}}" class="hover:text-indigo-700 hover:underline">{{nome}}</a></td>
            {{!-- categoria.nome e fornecedor.nome existem graças ao populate() --}}
            <td class="px-5 py-3">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">{{categoria.nome}}</span>
            </td>
            <td class="px-5 py-3 text-gray-700">{{fornecedor.nome}}</td>
            <td class="px-5 py-3 text-gray-700 tabular-nums whitespace-nowrap">{{dinheiro preco}}</td>
            <td class="px-5 py-3 font-semibold tabular-nums">{{quantidade}}</td>
            {{!-- Preenchido pelo script.js com o selo "OK" ou "Estoque baixo" --}}
            <td class="px-5 py-3 situacao"></td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <a href="/produtos/editar/{{_id}}" class="text-indigo-700 hover:text-indigo-900 font-medium hover:underline mr-3">Editar</a>
              <form action="/produtos/deletar" method="POST" class="inline form-deletar">
                <input type="hidden" name="id" value="{{_id}}">
                <button type="submit" class="text-red-600 hover:text-red-800 font-medium hover:underline">Deletar</button>
              </form>
            </td>
          </tr>
        {{else}}
          <tr><td colspan="8" class="px-5 py-10 text-center text-gray-500">Nenhum produto encontrado.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
