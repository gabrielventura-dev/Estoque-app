<div class="max-w-lg mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Editar categoria</h1>
    <p class="text-sm text-gray-500 mt-1">Altere os dados e salve.</p>
  </div>

  {{!-- Erros de validação enviados pela rota (array "erros" com objetos { texto }) --}}
  {{#each erros}}
    <div class="mb-4 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm" role="alert">{{texto}}</div>
  {{/each}}

  {{!-- method POST: os campos chegam na rota em req.body (body-parser) --}}
  <form action="/categorias/editar" method="POST" class="bg-white p-6 sm:p-8 rounded-xl shadow-sm border border-gray-200 space-y-4">
    {{!-- Campo escondido com o _id: a rota usa req.body.id para saber quem editar --}}
    <input type="hidden" name="id" value="{{categoria._id}}">
    <div>
      <label for="nome" class="block text-sm font-medium text-gray-700 mb-1">Nome</label>
      <input type="text" id="nome" name="nome" value="{{categoria.nome}}" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none">
    </div>
    <div>
      <label for="slug" class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
      <input type="text" id="slug" name="slug" value="{{categoria.slug}}" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none">
    </div>
    <div class="pt-3 flex flex-col sm:flex-row gap-3">
      <button type="submit" class="flex-1 bg-indigo-700 text-white py-2.5 px-4 rounded-lg hover:bg-indigo-800 transition font-semibold">Salvar alterações</button>
      <a href="/categorias" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 transition text-sm font-medium">Cancelar</a>
    </div>
  </form>
</div>
