<div class="max-w-2xl mx-auto">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Categorias</h1>
      <p class="text-sm text-gray-500">Organize seus produtos por categoria.</p>
    </div>
    <a href="/categorias/nova" class="inline-flex items-center justify-center self-start sm:self-auto bg-indigo-700 text-white px-4 py-2 rounded-lg hover:bg-indigo-800 transition text-sm font-medium whitespace-nowrap">+ Nova categoria</a>
  </div>

  {{!-- Cada categoria vira uma linha; "categorias" vem de routes/categorias.js --}}
  <ul class="bg-white rounded-xl shadow-sm border border-gray-200 divide-y divide-gray-100 overflow-hidden" role="list">
    {{#each categorias}}
      <li class="flex items-center justify-between gap-3 px-5 py-3 hover:bg-gray-50 transition">
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
          <div>
            <p class="text-sm font-medium text-gray-900">{{nome}}</p>
            <p class="text-xs text-gray-500">Slug: {{slug}}</p>
          </div>
        </div>
        <div class="flex items-center gap-3 text-sm whitespace-nowrap">
          <a href="/categorias/editar/{{_id}}" class="text-indigo-700 hover:text-indigo-900 font-medium hover:underline">Editar</a>
          {{!-- Deletar é um POST com o id escondido; a classe form-deletar ativa o confirm() do script.js --}}
          <form action="/categorias/deletar" method="POST" class="inline form-deletar">
            <input type="hidden" name="id" value="{{_id}}">
            <button type="submit" class="text-red-600 hover:text-red-800 font-medium hover:underline">Deletar</button>
          </form>
        </div>
      </li>
    {{else}}
      <li class="px-5 py-10 text-center text-sm text-gray-500">Nenhuma categoria cadastrada.</li>
    {{/each}}
  </ul>
</div>
