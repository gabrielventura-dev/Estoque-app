<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Fornecedores</h1>
    <p class="text-sm text-gray-500">Empresas que abastecem o estoque.</p>
  </div>
  <a href="/fornecedores/novo" class="inline-flex items-center justify-center self-start sm:self-auto bg-indigo-700 text-white px-4 py-2 rounded-lg hover:bg-indigo-800 transition text-sm font-medium whitespace-nowrap">+ Novo fornecedor</a>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Nome</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">CNPJ</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Telefone</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">E-mail</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600 text-right">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{!-- Uma linha da tabela para cada fornecedor --}}
        {{#each fornecedores}}
          <tr class="border-b last:border-b-0">
            <td class="px-5 py-3 font-medium text-gray-900">{{nome}}</td>
            <td class="px-5 py-3 text-gray-700 tabular-nums">{{cnpj}}</td>
            <td class="px-5 py-3 text-gray-700 tabular-nums">{{telefone}}</td>
            <td class="px-5 py-3 text-gray-700">{{email}}</td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <a href="/fornecedores/editar/{{_id}}" class="text-indigo-700 hover:text-indigo-900 font-medium hover:underline mr-3">Editar</a>
              {{!-- form-deletar: o script.js pede confirmação antes de enviar --}}
              <form action="/fornecedores/deletar" method="POST" class="inline form-deletar">
                <input type="hidden" name="id" value="{{_id}}">
                <button type="submit" class="text-red-600 hover:text-red-800 font-medium hover:underline">Deletar</button>
              </form>
            </td>
          </tr>
        {{else}}
          <tr><td colspan="5" class="px-5 py-10 text-center text-gray-500">Nenhum fornecedor cadastrado.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
