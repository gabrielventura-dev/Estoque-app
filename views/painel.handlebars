<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Painel</h1>
    <p class="text-sm text-gray-500">Resumo geral do estoque e alertas de reposição.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/movimentacoes" class="inline-flex items-center gap-1.5 bg-white border border-gray-300 text-gray-700 px-3.5 py-2 rounded-lg hover:bg-gray-50 transition text-sm font-medium">Movimentações</a>
    <a href="/produtos/cadastrar" class="inline-flex items-center gap-1.5 bg-indigo-700 text-white px-4 py-2 rounded-lg hover:bg-indigo-800 transition text-sm font-medium">+ Novo Produto</a>
  </div>
</div>

<!-- Cards com os totais principais do estoque -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
  <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200 flex items-start gap-4">
    <div class="p-2.5 bg-indigo-50 rounded-lg text-indigo-600 shrink-0" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
    </div>
    <div>
      <h2 class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-1">Total de Produtos</h2>
      <p class="text-2xl font-bold text-gray-900 tabular-nums">{{totalProdutos}}</p>
    </div>
  </div>
  <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200 flex items-start gap-4">
    <div class="p-2.5 bg-red-50 rounded-lg text-red-600 shrink-0" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    </div>
    <div>
      <h2 class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-1">Estoque Baixo</h2>
      <p class="text-2xl font-bold text-red-600 tabular-nums">{{estoqueBaixo}}</p>
    </div>
  </div>
  <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200 flex items-start gap-4">
    <div class="p-2.5 bg-emerald-50 rounded-lg text-emerald-600 shrink-0" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 9v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    </div>
    <div>
      <h2 class="text-xs uppercase tracking-wider font-semibold text-gray-500 mb-1">Valor Total em Estoque</h2>
      <p class="text-2xl font-bold text-gray-900 tabular-nums">R$ {{toFixed valorTotal 2}}</p>
    </div>
  </div>
</div>

<!-- Tabela só com os produtos abaixo do estoque mínimo -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="px-5 py-4 border-b border-gray-200 flex flex-wrap items-center justify-between gap-2">
    <h2 class="font-semibold text-gray-900">Produtos com estoque baixo</h2>
    <a href="/produtos" class="text-sm text-indigo-700 hover:underline font-medium">Ver todos os produtos</a>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Produto</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Quantidade</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Mínimo</th>
          <th scope="col" class="px-5 py-3 font-medium text-gray-600">Status</th>
        </tr>
      </thead>
      <tbody>
        {{#if produtos.length}}
          {{#each produtos}}
          <tr class="border-b last:border-b-0 {{#if (gt quantidade estoqueMinimo)}}text-green-700{{else}}text-red-700{{/if}}">
            <td class="px-5 py-3 font-medium text-gray-900">{{nome}}</td>
            <td class="px-5 py-3 tabular-nums font-semibold">{{quantidade}}</td>
            <td class="px-5 py-3 tabular-nums text-gray-600">{{estoqueMinimo}}</td>
            <td class="px-5 py-3">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold {{#if (gt quantidade estoqueMinimo)}}bg-green-100 text-green-800{{else}}bg-red-100 text-red-800{{/if}}">
                {{#if (gt quantidade estoqueMinimo)}}OK{{else}}BAIXO{{/if}}
              </span>
            </td>
          </tr>
          {{/each}}
        {{else}}
          <tr>
            <td class="px-5 py-10 text-center text-gray-500" colspan="4">Nenhum produto com estoque baixo. Tudo em dia!</td>
          </tr>
        {{/if}}
      </tbody>
    </table>
  </div>
</div>
